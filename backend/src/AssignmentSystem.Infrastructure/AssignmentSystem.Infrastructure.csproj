<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AssignmentSystem.Application\AssignmentSystem.Application.csproj" />
    <ProjectReference Include="..\AssignmentSystem.Domain\AssignmentSystem.Domain.csproj" />
  </ItemGroup>

  <!-- EF Core generates Migrations with its own conventions (classic namespaces,
       inline array args). Exclude them from code analysis so the strict rules
       (treat-warnings-as-errors) don't block on tooling-produced code. -->
  <ItemGroup>
    <Compile Update="Migrations\**\*.cs">
      <GeneratedCode>true</GeneratedCode>
    </Compile>
  </ItemGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1861;IDE0161</NoWarn>
  </PropertyGroup>

  <!-- Storage internals (path resolution, upload signature checks) are security-critical
       and worth unit-testing directly, without making them part of the public surface. -->
  <ItemGroup>
    <InternalsVisibleTo Include="AssignmentSystem.Api.Tests" />
    <InternalsVisibleTo Include="AssignmentSystem.Application.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.3.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
  </ItemGroup>

</Project>
