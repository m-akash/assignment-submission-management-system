{
  "AllowedHosts": "*",

  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName"]
  },

  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=assignment_system;Username=assignments;Password=assignments;Include Error Detail=true"
  },

  "Jwt": {
    "Issuer": "AssignmentSystem.Api",
    "Audience": "AssignmentSystem.Web",
    "AccessTokenMinutes": 5,
    "RefreshTokenDays": 7,
    "Key": "CHANGE_ME_THIS_MUST_BE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG_xxxx"
  },

  "Cors": {
    "Origins": ["http://localhost:3000"]
  },

  "FileStorage": {
    "Root": "../_uploads",
    "MaxBytes": 10485760,
    "MaxFilesPerSubmission": 3,
    "AllowedExtensions": ["pdf", "docx", "doc", "txt", "png", "jpg", "jpeg", "zip"]
  },

  "Database": {
    "AutoMigrate": true,
    "SeedOnStartup": true
  }
}
