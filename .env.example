# ─────────────────────────────────────────────────────────────────────────────
# Assignment & Submission Management System — sample environment variables
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# These map to ASP.NET Core configuration keys via __ (double underscore) nesting.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=assignment_system
POSTGRES_USER=assignments
POSTGRES_PASSWORD=assignments

# EF Core connection string (used by the API)
ConnectionStrings__Default=Host=postgres;Port=5432;Database=assignment_system;Username=assignments;Password=assignments;Include Error Detail=true

# ── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANT: generate a strong secret, min 32 characters. `openssl rand -base64 48`
Jwt__Issuer=AssignmentSystem.Api
Jwt__Audience=AssignmentSystem.Web
Jwt__AccessTokenMinutes=5
Jwt__RefreshTokenDays=7
Jwt__Key=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48_AT_LEAST_32_CHARS

# ── CORS (comma-separated frontend origins) ──────────────────────────────────
Cors__Origins__0=http://localhost:3000

# ── Account setup ────────────────────────────────────────────────────────────
# Creating a user emails them a single-use link to choose their own password — no
# password is ever sent by email. This is how long that link stays valid, and the
# minimum length enforced when it is redeemed. The link is built from
# Email__AppBaseUrl below, so that must point at the frontend for it to be usable.
Auth__PasswordSetupTokenHours=48
Auth__MinimumPasswordLength=6

# ── Login throttling ─────────────────────────────────────────────────────────
# Two independent defences against password guessing, because neither covers the
# other's gap:
#   * Per account — consecutive wrong passwords lock the account for a cooling-off
#     window. Caps total guesses against one account however many addresses they
#     come from. A lockout is reported as an ordinary "invalid email or password",
#     so it never confirms that an address exists.
#   * Per client address — a request-rate cap on the credential endpoints, so no
#     single caller can work through a wordlist quickly in the first place.
Auth__MaxFailedLoginAttempts=5
Auth__LockoutMinutes=15
RateLimiting__CredentialsPerMinute=10

# ── Submission file storage ──────────────────────────────────────────────────
FileStorage__Root=/data/submissions
FileStorage__MaxBytes=2097152
FileStorage__MaxFilesPerSubmission=3
# Enforced together with a file-signature (magic byte) check — only list types whose
# bytes the server can verify. Archives are excluded on purpose.
FileStorage__AllowedExtensions__0=pdf
FileStorage__AllowedExtensions__1=docx
FileStorage__AllowedExtensions__2=doc
FileStorage__AllowedExtensions__3=txt
FileStorage__AllowedExtensions__4=png
FileStorage__AllowedExtensions__5=jpg
FileStorage__AllowedExtensions__6=jpeg

# ── Email notifications ──────────────────────────────────────────────────────
# Three working configurations, in order of how close they are to production:
#
#  1. Mailpit (the default under `docker compose up`, and what is set below). A real
#     SMTP handshake against a catch-all server that delivers nothing onward — read
#     every message at http://localhost:8025. Use Host=localhost when running the API
#     with `dotnet run` outside compose, and Host=mailpit from inside it.
#
#  2. A real provider. For Gmail use an App Password, not the account password:
#     Host=smtp.gmail.com Port=587 UseSsl=true, Username and FromAddress both the
#     sending address. Change Port and UseSsl together with Host — the values below
#     are Mailpit's plaintext ones and a provider will reject them.
#
#  3. Email__Host EMPTY. No mail server at all: notifications are still queued in the
#     `notifications` table and written to the API log instead of being sent, so the
#     feature stays demonstrable with nothing installed. The rows are marked Sent
#     because there is nothing to retry against — check the log, not the inbox.
Email__Host=mailpit
Email__Port=1025
Email__UseSsl=false
Email__Username=
Email__Password=
Email__FromAddress=noreply@assignment-system.local
Email__FromName=Assignment System

# Outbox dispatcher: how often to sweep, how many per sweep, and how many attempts
# before a notification is parked as Failed for an admin to retry.
Email__EnableDispatcher=true
Email__DispatchIntervalSeconds=30
Email__BatchSize=25
Email__MaxDeliveryAttempts=3
# Failed rows are retried behind an exponential backoff from this base delay, so an
# unreachable mail server is backed away from rather than hit once per sweep. A row a
# dispatcher was holding when it died is reclaimed by another sweep after the claim timeout.
Email__RetryBackoffSeconds=30
Email__ClaimTimeoutSeconds=300

# Where the frontend lives — used to build the "open it here" link in email bodies.
Email__AppBaseUrl=http://localhost:3000

# ── Bootstrap behaviour ──────────────────────────────────────────────────────
Database__AutoMigrate=true
Database__SeedOnStartup=true
ASPNETCORE_ENVIRONMENT=Development

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
# Base origin only — the frontend appends /api/v1/... itself (see lib/api.ts).
NEXT_PUBLIC_API_URL=http://localhost:5080
