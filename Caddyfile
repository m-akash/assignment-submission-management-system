{
	# email you@example.com   # uncomment + set when you add a real domain
}

# HTTPS (primary). Self-signed cert, auto-generated by Caddy's internal CA.
:443 {
	tls internal

	# /api/* and /health → backend (.NET API on 8080)
	@api path /api/* /health
	reverse_proxy @api api:8080

	# Everything else → Next.js frontend (3000)
	reverse_proxy web:3000
}

# HTTP — redirect to HTTPS (so the Secure cookie flow always upgrades).
:80 {
	redir https://{host}{uri} permanent
}
